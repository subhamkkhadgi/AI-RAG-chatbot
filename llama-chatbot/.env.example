# =============================================================================
# llama-chatbot — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# Never commit .env to version control.
# =============================================================================

# ── Provider Selection ───────────────────────────────────────────────────────
# Options: "groq" (cloud) or "ollama" (local)
LLM_PROVIDER=groq

# ── Groq (Cloud Inference) ──────────────────────────────────────────────────
# Get your API key at: https://console.groq.com/keys
# Only required when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# ── Ollama (Local Inference) ────────────────────────────────────────────────
# Host URL — change if running Ollama on a different machine or port.
# Only required when LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Default System Prompt ───────────────────────────────────────────────────
# This is the initial system message prepended to every conversation.
# Override in the sidebar at runtime.
# Single source of truth: src/prompts/system_prompts.py (get_default_prompt()).
# Uncomment and set a value only to override that default: it takes precedence.
# DEFAULT_SYSTEM_PROMPT=Your custom prompt here.
# ── Inference Parameters (defaults — overridable in sidebar) ────────────────
TEMPERATURE=0.7
MAX_TOKENS=2048

# ── Network & Logging ───────────────────────────────────────────────────────
# Request timeout in seconds for provider API calls
REQUEST_TIMEOUT=30

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Cross-encoder Reranking (optional feature, DEFAULT OFF) ─────────────────
# Enables: Qdrant Top-N -> MiniLM reranker -> greedy page-diverse Top-M context.
# When ENABLED the retriever is relaxed (max_documents unlimited) so the
# reranker sees a genuine cross-document candidate pool.
# Requires the optional dependency: sentence-transformers (+ torch/transformers).
# RERANKER_ENABLED=false
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKER_CANDIDATE_LIMIT=10
# RERANKER_FINAL_LIMIT=3

